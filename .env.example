# Show the "Project" page (/project, rendered from content/project.md) and its nav links.
# Set to false to hide it. Restart the dev server or rebuild after changing.
NEXT_PUBLIC_SHOW_PROJECT_PAGE=true

# Drone body lighting until a visitor chooses otherwise in Look > Drone lighting:
#   true  - the whole drone glows in its colour (default)
#   false - realistic: dark airframes lit by their own lamp
# A visitor's own choice always wins and is remembered on their device.
NEXT_PUBLIC_DRONE_GLOW=true
